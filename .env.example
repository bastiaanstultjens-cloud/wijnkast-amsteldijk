# Kopieer naar .env.local voor `npx vercel dev`. Op Vercel zet je deze bij Settings > Environment Variables.
ANTHROPIC_API_KEY=
# optioneel, standaard claude-sonnet-5-5
ANTHROPIC_MODEL=
# zelfde waarden als in config.js; dan accepteert /api/claude alleen ingelogde gebruikers
SUPABASE_URL=
SUPABASE_ANON_KEY=
